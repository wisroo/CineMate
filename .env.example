# --- Azure OpenAI (사내망 AOAI) 사용 시 아래 변수 설정 ---
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_API_KEY=...
AOAI_API_VERSION=2024-02-01
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
# 채팅용 배포명 (에이전트 구현 시 사용)
# AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
# AOAI_DEPLOY_GPT4O=gpt-4o

# --- OpenAI 직연결 사용 시 (AOAI_* 미설정일 때만) ---
# OPENAI_API_KEY=sk-...

TMDB_API_KEY=...
# TMDB API 키 발급 시 "Application URL": 개발 중에는 http://localhost:8501 또는 https://www.example.com

TAVILY_API_KEY=...
